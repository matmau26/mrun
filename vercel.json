{
  "outputDirectory": ".",
  "redirects": [
    { "source": "/utv26.html", "destination": "/UTV26.html", "permanent": false },
    { "source": "/Utv26.html", "destination": "/UTV26.html", "permanent": false },
    { "source": "/utv26", "destination": "/UTV26.html", "permanent": false },
    { "source": "/UTV26", "destination": "/UTV26.html", "permanent": false },
    { "source": "/Utv26", "destination": "/UTV26.html", "permanent": false }
  ],
  "headers": [
    {
      "source": "/matmau.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/UTV26.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, noimageindex" }
      ]
    },
    {
      "source": "/utv26-sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/assets/(css|js)/plan(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
